# Urbaner — credenciales de prueba
# Copia este archivo como  .env  (en esta misma carpeta) y complétalo.

# Entorno: sandbox | production
URBANER_ENV=sandbox

# ─── Login (Urbaner usa email + password → devuelve auth_token) ───
# Crea cuenta sandbox en: https://app.sandbox.urbaner.com/registro
URBANER_EMAIL=
URBANER_PASSWORD=

# ─── Parámetros opcionales de la prueba ───
# Por defecto cotiza Miraflores → San Isidro con vehículo "auto" (id 2).
# Confirma los IDs de vehículo con tu doc de Urbaner / soporte.
# URBANER_PICKUP_LATLON=-12.122550,-77.029700
# URBANER_DROPOFF_LATLON=-12.097200,-77.036300
# URBANER_VEHICLE_ID=2
