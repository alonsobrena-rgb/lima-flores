# Envíame — credenciales de prueba
# Copia este archivo como  .env  (en esta misma carpeta) y complétalo.

# Entorno: stage | production
ENVIAME_ENV=stage

# ─── v2 (cotización de tarifas) — header api-key ───
ENVIAME_API_KEY=

# ─── v3 (crear envío + tracking) — OAuth client_credentials (Auth0) ───
# Soporte de Envíame te entrega estos 3 valores para tu cuenta:
ENVIAME_AUTH_URL=
ENVIAME_AUDIENCE=
ENVIAME_CLIENT_ID=
ENVIAME_CLIENT_SECRET=

# ─── Parámetros de la prueba /rates ───
# Los nombres reales dependen de tu cuenta/país — los confirmas con tu doc/soporte.
# Ejemplo (ajustar):
# ENVIAME_RATES_PARAMS={"origin_place":"PE-LIMA-MIRAFLORES","destination_place":"PE-LIMA-SAN-ISIDRO","weight":3}
