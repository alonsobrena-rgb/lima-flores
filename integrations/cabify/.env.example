# Cabify Logistics — credenciales de prueba
# Copia este archivo como  .env  (en esta misma carpeta) y complétalo.

# Entorno: sandbox | production
CABIFY_ENV=sandbox

# Credenciales OAuth (se generan en tu cuenta de Cabify Logistics → API key)
CABIFY_CLIENT_ID=
CABIFY_CLIENT_SECRET=

# (Opcional) URLs de producción si difieren — confirmar con Cabify
# CABIFY_AUTH_BASE=https://cabify.com
# CABIFY_LOGISTICS_BASE=https://logistics.api.cabify.com

# Punto de recojo (atelier) — Calle Francia 823, Miraflores (coords aprox., ajusta)
LF_PICKUP_LAT=-12.1219
LF_PICKUP_LON=-77.0297

# Dirección de entrega de ejemplo (cliente) para la prueba
LF_DROPOFF_LAT=-12.1000
LF_DROPOFF_LON=-77.0200
