# 99minutos — credenciales de prueba
# Copia este archivo como  .env  (en esta misma carpeta) y complétalo.

# Entorno (solo etiqueta — 99minutos usa la misma URL base para ambos,
# la diferencia son las credenciales). sandbox | production
NINETYNINE_ENV=sandbox

# Base URL (rara vez cambia). Default: https://delivery.99minutos.com
# NINETYNINE_BASE_URL=https://delivery.99minutos.com

# ─── OAuth client_credentials ───
# Los obtienes al crear cuenta en https://developers.99minutos.com/
# (cuenta sandbox y producción son independientes — credenciales distintas).
NINETYNINE_CLIENT_ID=
NINETYNINE_CLIENT_SECRET=

# ─── Parámetros opcionales del paquete para la prueba ───
# Defaults: 3 kg, 30×30×40 cm (un arreglo floral mediano).
# NINETYNINE_WEIGHT_G=3000
# NINETYNINE_HEIGHT_CM=30
# NINETYNINE_WIDTH_CM=30
# NINETYNINE_LENGTH_CM=40
