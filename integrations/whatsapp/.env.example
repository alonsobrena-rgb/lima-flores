# WhatsApp Cloud API (Meta) — Promociones por WhatsApp
# Copia este archivo a integrations/whatsapp/.env (local) o define estas vars
# en el dashboard de Railway (producción). Ver README.md para obtenerlas.
#
# LO NORMAL ES NO NECESITAR NINGUNA DE ESTAS. El número, la WABA y la app se
# conectan desde el panel (Admin → Promociones WhatsApp → Conexión), y el token
# por defecto es el mismo de Instagram: IG_ACCESS_TOKEN, con los permisos
# whatsapp_business_messaging y whatsapp_business_management agregados.
#
# Lo de abajo es el respaldo: si el panel no tiene el dato, se usa la variable.

# Token propio de WhatsApp, si no se quiere reutilizar el de Instagram. Puede ir
# con cualquier nombre que empiece por WA_ (o IG_) y escribirse en el panel.
WA_TOKEN=

# Id del número emisor (Cloud API) — WhatsApp Manager → API Setup.
WA_PHONE_NUMBER_ID=

# Id de la WhatsApp Business Account (WABA).
WA_WABA_ID=

# Id de la app de Meta (necesario solo para subir la foto del header al crear
# plantillas vía resumable upload).
WA_APP_ID=

# Versión del Graph API (opcional). La comparten WhatsApp y el publicador de IG.
WA_GRAPH_VERSION=v21.0
