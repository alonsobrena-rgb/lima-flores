# Producción (Railway): instalar solo dependencias de runtime.
omit=dev

# Puppeteer (dependencia de prod, para las tarjetas de regalo) NO debe descargar
# Chromium en el build: esa descarga es flaky y rompe el deploy (extracción de
# Chrome v149 falla en el builder de Nixpacks). En su lugar usamos el chromium
# del sistema que Nixpacks instala vía apt (ver integrations/cards/generate.js →
# resolveChromium). En local, puppeteer usa el Chrome ya bundleado si existe.
puppeteer_skip_download=true
