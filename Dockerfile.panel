# Build del panel React (app/) como servicio estático en Railway.
# Se selecciona con la variable RAILWAY_DOCKERFILE_PATH=Dockerfile.panel en el
# servicio lima-flores-panel. El contexto de build es la raíz del repo.
FROM node:20-alpine AS build
WORKDIR /panel
COPY app/package.json app/package-lock.json ./
RUN npm ci
COPY app/ ./
# Vite hornea las VITE_* en build-time → llegan como build args desde Railway.
ARG VITE_API_BASE
ARG VITE_GOOGLE_MAPS_KEY
ARG VITE_CULQI_PUBLIC_KEY
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_GOOGLE_MAPS_KEY=$VITE_GOOGLE_MAPS_KEY
ENV VITE_CULQI_PUBLIC_KEY=$VITE_CULQI_PUBLIC_KEY
RUN npm run build

# Runtime: sirve dist/ como SPA. serve respeta $PORT y enruta a index.html (-s).
EXPOSE 3000
CMD ["sh", "-c", "npx serve -s dist -l tcp://0.0.0.0:${PORT:-3000}"]
